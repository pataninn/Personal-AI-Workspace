# Nginx config fragment for inclusion at http {} scope; log_format is http-context only.
# The EC2 host must have no public IP, and its host security group must allow only TCP 8080
# from the AWS-managed CloudFront VPC-origin security group.
# Keep a status-only access record. Raw upstream error context can contain query strings, so discard it;
# app Pino method/status records and CloudFront metrics remain available for diagnostics.
log_format personal_ai_proxy '$request_method $status $upstream_status $request_time';
#
# Replace 10.0.0.0/16 with the actual VPC CIDR containing the CloudFront origin ENIs before
# enabling this server. That CIDR is safe to trust here only while the host SG source remains
# the CloudFront service-managed security group. Never use 0.0.0.0/0 or ::/0.
# After deployment, set the app's TRUSTED_PROXY_CIDRS to only the observed Docker host-gateway
# source as an exact /32. Do not trust the whole Docker bridge, VPC, or RFC1918 ranges in the app.
server {
    listen 8080;
    # The forwarded Host is the CloudFront hostname; this is the only server, and the app validates Origin against APP_ORIGIN.
    server_name _;
    # This app accepts file uploads up to 8 MiB. Keep Nginx's request limit aligned.
    client_max_body_size 8m;
    # No URI, arguments, headers, cookies, or client address are written.
    access_log /var/log/nginx/personal-ai-proxy.log personal_ai_proxy;
    error_log /dev/null crit;

    # CloudFront-Viewer-Address is added by AppOriginRequestPolicy; it is not forwarded from the viewer.
    # Only replace the peer address after the CloudFront source CIDR and host SG are verified.
    set_real_ip_from 10.0.0.0/16;
    real_ip_header CloudFront-Viewer-Address;
    real_ip_recursive off;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_pass_request_headers on;

        # Preserve viewer Origin and cookies; all other app headers pass through by default.
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header If-Match $http_if_match;

        # Replace client supplied forwarding values with the address verified above.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header X-Client-IP "";

        # Keep SSE unbuffered. The app emits a heartbeat every 15 seconds.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 5s;

        # The app certificate must cover this internal SAN and chain to the configured CA.
        # Replace the example SAN and CA path with the installed certificate's actual values.
        proxy_ssl_server_name on;
        proxy_ssl_name app.internal.personal-ai-workspace;
        proxy_ssl_trusted_certificate /etc/personal-ai-workspace/tls/app-ca.pem;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        # The app does not require WebSockets; do not forward upgrade semantics.
        proxy_set_header Connection "";
        proxy_set_header Upgrade "";
    }
}
