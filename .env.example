# Dedicated Windows workspace. Do not point this at a drive root, home directory,
# OneDrive root, or the repository parent.
WORKSPACE_HOST_ROOT=C:\\PersonalAIWorkspace
WORKSPACE_IDENTITY=replace-with-preflight-marker
WORKSPACE_IDENTITY_FILE=/workspace/.personal-ai-workspace-identity

APP_PORT=8443
APP_PROTOCOL=https
TLS_CERT_DIR=./docker/certs
POSTGRES_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# Compose defaults this host path to ./secrets/local_user_password. Create it
# locally with the operator instructions in README.md; never commit its value.
# LOCAL_USER_PASSWORD_FILE=./secrets/local_user_password

# Compose reads this host path to create a Docker secret. The app receives only
# the read-only /run/secrets/nvidia_api_key mount, never the host path or value.
NVIDIA_API_KEY_FILE=./secrets/nvidia_api_key

# MVP1 uses the direct backend provider adapter. Set AGENT_RUNTIME_MODE=fake
# only for development/test runs; production must use direct.
NIM_PROFILE=nvidia-hosted-nim
NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_RUNTIME_MODE=direct
