# Copy this file to .env in this application repository and fill in the values.
# Set this to the exact application repository or dedicated workspace directory.
WORKSPACE_HOST_ROOT=C:/replace/with/Personal-AI-Workspace
WORKSPACE_IDENTITY=replace-with-preflight-marker
WORKSPACE_IDENTITY_FILE=/workspace/.personal-ai-workspace-identity

APP_PORT=8443
APP_PROTOCOL=https
# Optional: exact browser origin (scheme, host and optional port; no path).
# Set this after choosing the public domain; unset preserves the loopback URL.
# APP_ORIGIN=https://app.example.com
TLS_CERT_DIR=C:/Users/replace-user/AppData/Local/Personal-AI-Workspace/private/tls
POSTGRES_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
# Anonymous demo: choose safe content in Admin > Demo content, then publish it.
# Compose supplies the modest limits below. Existing saved settings are preserved.
# Generate a separate random secret (at least 32 bytes); do not reuse SESSION_SECRET.
DEMO_NETWORK_HASH_SECRET=replace-with-a-separate-random-secret
DEMO_SESSION_TTL_HOURS=24
DEMO_GLOBAL_ADMISSION_MAX=4
DEMO_GLOBAL_ADMISSION_WINDOW_SECONDS=3600
DEMO_NETWORK_ADMISSION_MAX=2
DEMO_NETWORK_ADMISSION_WINDOW_SECONDS=3600
DEMO_RUN_START_MAX=10
DEMO_RUN_START_WINDOW_SECONDS=3600
SHOWCASE_MAX_SNAPSHOT_BYTES=8388608
SHOWCASE_MAX_FILE_BYTES=1048576
SHOWCASE_MAX_ITEMS=200
SHOWCASE_MAX_FILES=20
SHOWCASE_MAX_RETAINED_VERSIONS=3
DEMO_SHOWCASE_COPY_MAX_ATTEMPTS=3
# Optional: exact CIDRs of trusted reverse proxies; unset means direct peer only.
# TRUSTED_PROXY_CIDRS=<comma-separated IPv4/IPv6 CIDRs>
# The relocation helper assigns isolated MVP2 volume names. These defaults
# preserve the existing MVP1 volume names for other local environments.
POSTGRES_VOLUME_NAME=pai_pg_data
RECOVERY_VOLUME_NAME=pai_recovery
# Optional process-visible free-space warning threshold, selected after deployment mount verification.
# STORAGE_DISK_WARNING_FREE_BYTES=<positive decimal bytes>

# Ignored local secret files. Never commit their contents.
LOCAL_USER_PASSWORD_FILE=./secrets/local_user_password

# The startup helper reads this key for the WSL gateway. It is never mounted in
# the app container or disposable Hermes project. Relative paths are repo-relative.
NEBIUS_API_KEY_FILE=./secrets/nebius_api_key

# Use scripts/start-hermes.ps1 to prepare the installed WSL runtime and select
# hermes. Hermes is the supported production runtime; fake is development only.
NIM_PROFILE=nebius-token-factory
NIM_ENDPOINT=https://api.tokenfactory.nebius.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Regular accounts can settle missing Home/workspace provider usage with labeled estimates.
# Input uses request UTF-8 bytes plus overhead; output uses the configured cap.
NIM_ALLOW_ESTIMATED_HOME_USAGE=false
AGENT_RUNTIME_MODE=hermes
HERMES_BRIDGE_ENDPOINT=https://host.docker.internal:17871
# Compose supplies the client TLS paths inside the app container. Local Node
# runs need HERMES_BRIDGE_CA_FILE, HERMES_BRIDGE_CERT_FILE, HERMES_BRIDGE_KEY_FILE.
