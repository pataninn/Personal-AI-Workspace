# Dedicated Windows workspace. Do not point this at a drive root, home directory,
# OneDrive root, or the repository parent.
WORKSPACE_HOST_ROOT=C:\\PersonalAIWorkspace
WORKSPACE_IDENTITY=replace-with-preflight-marker
WORKSPACE_IDENTITY_FILE=/workspace/.personal-ai-workspace-identity

APP_PORT=8443
APP_PROTOCOL=https
TLS_CERT_DIR=./docker/certs
POSTGRES_PASSWORD=replace-with-a-local-secret
NVIDIA_API_KEY_FILE=./secrets/nvidia_api_key

# These values are required before Compose can start. The app never receives the
# NVIDIA API key; only the gateway receives the provider secret.
OPENSHELL_IMAGE=replace-with-reviewed-openshell-image
OPENSHELL_CLIENT_ID=personal-ai-app
OPENSHELL_CLIENT_TOKEN=replace-with-a-long-random-client-token
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Production must remain openshell until a release-matched SDK/CLI, transfer path,
# gateway capability/auth, and provider route are verified. Use fake only in
# NODE_ENV=development or test for deterministic local/CI journeys.
AGENT_RUNTIME_MODE=openshell
