# Copy this file to .env in this application repository and fill in the values.
# Set this to the exact application repository or dedicated workspace directory.
WORKSPACE_HOST_ROOT=C:/replace/with/Personal-AI-Workspace
WORKSPACE_IDENTITY=replace-with-preflight-marker
WORKSPACE_IDENTITY_FILE=/workspace/.personal-ai-workspace-identity

APP_PORT=8443
APP_PROTOCOL=https
TLS_CERT_DIR=C:/Users/replace-user/AppData/Local/Personal-AI-Workspace/private/tls
POSTGRES_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
# The relocation helper assigns isolated MVP2 volume names. These defaults
# preserve the existing MVP1 volume names for other local environments.
POSTGRES_VOLUME_NAME=pai_pg_data
RECOVERY_VOLUME_NAME=pai_recovery

# Keep this host file outside the application repository.
LOCAL_USER_PASSWORD_FILE=C:/Users/replace-user/AppData/Local/Personal-AI-Workspace/private/secrets/local_user_password

# Compose reads this external host file to create a Docker secret. The app receives
# only the read-only /run/secrets/nvidia_api_key mount, never the host path or value.
NVIDIA_API_KEY_FILE=C:/Users/replace-user/AppData/Local/Personal-AI-Workspace/private/secrets/nvidia_api_key

# MVP1 uses the direct backend provider adapter. Set AGENT_RUNTIME_MODE=fake
# only for development/test runs; production must use direct.
NIM_PROFILE=nvidia-hosted-nim
NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_RUNTIME_MODE=direct
