{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "vite.config.mjs",
    "vitest.config.mjs",
    "preview/**/*.mjs"
  ]
}
