{
  "name": "personal-ai-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test:integration": "pnpm --filter personal-ai-workspace-backend test:integration",
    "test:boundaries": "node --test scripts/compose-boundary-check.test.mjs",
    "test:relocation-paths": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/move-local-private-files.reparse.test.ps1",
    "compose:config": "docker compose --project-name personal-ai-workspace-mvp2 --env-file \"%LOCALAPPDATA%\\Personal-AI-Workspace\\private\\.env\" config --quiet"
  }
}
