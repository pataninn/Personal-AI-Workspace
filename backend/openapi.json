{
  "openapi": "3.0.3",
  "info": {
    "title": "Personal AI Workspace API",
    "version": "0.1.0",
    "description": "Authenticated REST endpoints for project-scoped conversations and persisted messages."
  },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "Conversations" }, { "name": "Workspace files" }, { "name": "AI runs" }],
  "paths": {
    "/api/v1/projects/{projectId}/conversations": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "get": {
        "tags": ["Conversations"],
        "summary": "List project conversations",
        "operationId": "listProjectConversations",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ConversationListLimit" },
          { "$ref": "#/components/parameters/ConversationCursor" }
        ],
        "responses": {
          "200": { "description": "Conversation summaries in stable activity order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationListEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      },
      "post": {
        "tags": ["Conversations"],
        "summary": "Create a project conversation",
        "operationId": "createProjectConversation",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateConversationRequest" } } } },
        "responses": {
          "201": { "description": "Conversation created.", "headers": { "Location": { "$ref": "#/components/headers/Location" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationEnvelope" } } } },
          "200": { "description": "Identical idempotent request replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "409": { "$ref": "#/components/responses/MutationConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}": {
      "parameters": [{ "$ref": "#/components/parameters/ConversationIdPath" }],
      "get": {
        "tags": ["Conversations"],
        "summary": "Read a conversation history page",
        "operationId": "getConversationHistory",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectIdQuery" },
          { "$ref": "#/components/parameters/HistoryLimit" },
          { "$ref": "#/components/parameters/BeforeSequence" }
        ],
        "responses": {
          "200": { "description": "Conversation and messages in ascending sequence order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationHistoryEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/ConversationNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/conversations/{conversationId}/messages": {
      "parameters": [{ "$ref": "#/components/parameters/ConversationIdPath" }],
      "post": {
        "tags": ["Conversations"],
        "summary": "Persist one user message",
        "operationId": "createConversationMessage",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectIdQuery" },
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateMessageRequest" } } } },
        "responses": {
          "201": { "description": "Message created.", "headers": { "Location": { "$ref": "#/components/headers/Location" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageEnvelope" } } } },
          "200": { "description": "Identical idempotent request replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/ConversationNotFound" },
          "409": { "$ref": "#/components/responses/MutationConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/projects/{projectId}/ai-runs": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "post": {
        "tags": ["AI runs"],
        "summary": "Create an AI run intent and provider disclosure",
        "operationId": "createAiRunIntent",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAiRunRequest" } } } },
        "responses": {
          "202": { "description": "Manifest created without staging or provider transmission.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunIntentEnvelope" } } } },
          "200": { "description": "Identical idempotent request replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunIntentEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "409": { "$ref": "#/components/responses/MutationConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "get": {
        "tags": ["AI runs"],
        "summary": "Read an AI run status snapshot",
        "operationId": "getAiRun",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Safe run lifecycle snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/egress-manifest": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "get": {
        "tags": ["AI runs"],
        "summary": "Read the metadata-only provider disclosure",
        "operationId": "getAiRunEgressManifest",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Immutable manifest without raw content or credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EgressManifestEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "409": { "$ref": "#/components/responses/EgressConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/egress-decision": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "post": {
        "tags": ["AI runs"],
        "summary": "Approve or reject the exact provider disclosure",
        "operationId": "decideAiRunEgress",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EgressDecisionRequest" } } } },
        "responses": {
          "200": { "description": "Decision recorded; approval may return staging/runtime readiness.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EgressDecisionEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "409": { "$ref": "#/components/responses/EgressConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/commands": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "get": {
        "tags": ["AI runs"],
        "summary": "List bounded sandbox command proposals",
        "operationId": "listSandboxCommands",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Safe command proposal and result metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandListEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/commands/{commandId}": {
      "parameters": [
        { "$ref": "#/components/parameters/AiRunIdPath" },
        { "$ref": "#/components/parameters/CommandIdPath" }
      ],
      "get": {
        "tags": ["AI runs"],
        "summary": "Read one bounded sandbox command snapshot",
        "operationId": "getSandboxCommand",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Safe command proposal and result metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/CommandNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/commands/{commandId}/decision": {
      "parameters": [
        { "$ref": "#/components/parameters/AiRunIdPath" },
        { "$ref": "#/components/parameters/CommandIdPath" }
      ],
      "post": {
        "tags": ["AI runs"],
        "summary": "Approve or reject an exact sandbox command proposal",
        "operationId": "decideSandboxCommand",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandDecisionRequest" } } } },
        "responses": {
          "200": { "description": "Decision persisted before any runtime execution.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/CommandNotFound" },
          "409": { "$ref": "#/components/responses/CommandConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/commands/{commandId}/cancel": {
      "parameters": [
        { "$ref": "#/components/parameters/AiRunIdPath" },
        { "$ref": "#/components/parameters/CommandIdPath" }
      ],
      "post": {
        "tags": ["AI runs"],
        "summary": "Request best-effort sandbox command cancellation",
        "operationId": "cancelSandboxCommand",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmptyObject" } } } },
        "responses": {
          "200": { "description": "Cancellation already confirmed or command was not started.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandEnvelope" } } } },
          "202": { "description": "Cancellation request accepted for a running command.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SandboxCommandEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/CommandNotFound" },
          "409": { "$ref": "#/components/responses/CommandConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/CommandReviewRequired" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/start": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "post": {
        "tags": ["AI runs"],
        "summary": "Start an approved AI run in the private runtime",
        "operationId": "startAiRun",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmptyObject" } } } },
        "responses": {
          "202": { "description": "Run accepted; inference and persistence continue asynchronously.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunEnvelope" } } } },
          "200": { "description": "Identical idempotent request replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "409": { "$ref": "#/components/responses/MutationConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "post": {
        "tags": ["AI runs"],
        "summary": "Request whole-run cancellation",
        "operationId": "cancelAiRun",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OriginHeader" },
          { "$ref": "#/components/parameters/CsrfHeader" },
          { "$ref": "#/components/parameters/IdempotencyHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmptyObject" } } } },
        "responses": {
          "200": { "description": "Cancellation confirmed or the run was already terminal.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunEnvelope" } } } },
          "202": { "description": "Cancellation request accepted while runtime confirmation is pending.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiRunEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/MutationForbidden" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "409": { "$ref": "#/components/responses/MutationConflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/CommandReviewRequired" }
        }
      }
    },
    "/api/v1/ai-runs/{runId}/events": {
      "parameters": [{ "$ref": "#/components/parameters/AiRunIdPath" }],
      "get": {
        "tags": ["AI runs"],
        "summary": "Subscribe to best-effort AI run events",
        "operationId": "subscribeAiRunEvents",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "A non-durable event stream. Refetch the run and conversation after disconnect; no replay is provided.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/AiRunNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/projects/{projectId}/files": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "get": {
        "tags": ["Workspace files"],
        "summary": "List approved workspace entries",
        "operationId": "listWorkspaceFiles",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceDirectory" }],
        "responses": {
          "200": { "description": "Bounded project-relative file and directory entries.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceListEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/WorkspaceForbidden" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "413": { "$ref": "#/components/responses/WorkspaceLimit" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/projects/{projectId}/files/tree": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "get": {
        "tags": ["Workspace files"],
        "summary": "Read a bounded workspace tree",
        "operationId": "treeWorkspaceFiles",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceDirectory" },
          { "$ref": "#/components/parameters/WorkspaceDepth" }
        ],
        "responses": {
          "200": { "description": "Bounded nested project-relative entries.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceTreeEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/WorkspaceForbidden" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "413": { "$ref": "#/components/responses/WorkspaceLimit" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/projects/{projectId}/files/content": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "get": {
        "tags": ["Workspace files"],
        "summary": "Read one approved UTF-8 text file",
        "operationId": "readWorkspaceText",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspacePath" }],
        "responses": {
          "200": { "description": "Bounded, redacted UTF-8 text content.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceReadEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/WorkspaceForbidden" },
          "404": { "$ref": "#/components/responses/WorkspaceNotFound" },
          "413": { "$ref": "#/components/responses/WorkspaceLimit" },
          "415": { "$ref": "#/components/responses/WorkspaceUnsupported" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    },
    "/api/v1/projects/{projectId}/files/search": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectIdPath" }],
      "get": {
        "tags": ["Workspace files"],
        "summary": "Search approved UTF-8 text files",
        "operationId": "searchWorkspaceText",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceDirectory" },
          { "$ref": "#/components/parameters/WorkspaceQuery" },
          { "$ref": "#/components/parameters/WorkspaceMaxResults" }
        ],
        "responses": {
          "200": { "description": "Bounded project-relative text matches.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceSearchEnvelope" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/WorkspaceForbidden" },
          "404": { "$ref": "#/components/responses/ProjectNotFound" },
          "413": { "$ref": "#/components/responses/WorkspaceLimit" },
          "503": { "$ref": "#/components/responses/WorkspaceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "__Host-pa_session", "description": "Opaque authenticated local session cookie." }
    },
    "headers": {
      "Location": { "description": "Canonical URL of the created or replayed resource.", "schema": { "type": "string" } }
    },
    "parameters": {
      "ProjectIdPath": { "name": "projectId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "ConversationIdPath": { "name": "conversationId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "AiRunIdPath": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "CommandIdPath": { "name": "commandId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "ProjectIdQuery": { "name": "projectId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "ConversationListLimit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
      "HistoryLimit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 200 } },
      "BeforeSequence": { "name": "beforeSequence", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
      "ConversationCursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
      "WorkspaceDirectory": { "name": "directory", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 2048 }, "description": "Normalized project-relative directory. Absolute and host paths are rejected." },
      "WorkspaceDepth": { "name": "depth", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 6, "default": 2 } },
      "WorkspacePath": { "name": "path", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 2048 }, "description": "Normalized project-relative text file path." },
      "WorkspaceQuery": { "name": "query", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "WorkspaceMaxResults": { "name": "maxResults", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 200 } },
      "OriginHeader": { "name": "Origin", "in": "header", "required": true, "schema": { "type": "string", "format": "uri" } },
      "CsrfHeader": { "name": "X-CSRF-Token", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "IdempotencyHeader": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[\\x21-\\x7e]+$" } }
    },
    "responses": {
      "ValidationError": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "VALIDATION_ERROR", "message": "The conversation request is invalid.", "details": [{ "field": "title", "message": "Enter a conversation name." }] } } } } },
      "Unauthenticated": { "description": "No valid local session was supplied.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "SESSION_UNAUTHENTICATED", "message": "A valid local session is required." } } } } },
      "MutationForbidden": { "description": "Origin or CSRF verification failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "examples": { "origin": { "value": { "data": null, "error": { "code": "ORIGIN_FORBIDDEN", "message": "The request origin is not allowed." } } }, "csrf": { "value": { "data": null, "error": { "code": "CSRF_INVALID", "message": "The request could not be verified." } } } } } } },
      "ProjectNotFound": { "description": "The project is not available to this owner.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "PROJECT_NOT_FOUND", "message": "Project not found." } } } } },
      "ConversationNotFound": { "description": "The conversation is not available in the supplied project scope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "CONVERSATION_NOT_FOUND", "message": "Conversation not found." } } } } },
      "MutationConflict": { "description": "The project is archived or the idempotency key was reused with different content.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "examples": { "archived": { "value": { "data": null, "error": { "code": "PROJECT_ARCHIVED", "message": "This project is archived and read-only." } } }, "reused": { "value": { "data": null, "error": { "code": "IDEMPOTENCY_KEY_REUSED", "message": "This retry key was already used for different content." } } } } } } },
      "WorkspaceUnavailable": { "description": "The authoritative workspace boundary could not be verified safely.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "WorkspaceForbidden": { "description": "The project-relative path is protected, outside scope, or a reparse point.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "WorkspaceNotFound": { "description": "The project-relative entry was not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "WorkspaceUnsupported": { "description": "The entry is not an approved UTF-8 text file or is binary.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "WorkspaceLimit": { "description": "A bounded workspace inspection limit was exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "AiRunNotFound": { "description": "The AI run is not available to this owner.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "AI_RUN_NOT_FOUND", "message": "The AI run was not found." } } } } },
      "EgressConflict": { "description": "The egress manifest is stale or the decision has already changed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "RuntimeUnavailable": { "description": "The verified sandbox runtime is unavailable; no provider call is started.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "RUNTIME_UNAVAILABLE", "message": "The local sandbox gateway is unavailable. Nothing was staged or sent to NVIDIA." } } } } },
      "CommandNotFound": { "description": "The command is not available to this owner and run.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "CommandConflict": { "description": "The command proposal or decision is stale, blocked, or not executable in the current run state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "CommandReviewRequired": { "description": "The command cancellation or cleanup outcome is unknown; no automatic retry is started.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "InternalError": { "description": "Unexpected server failure.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }, "example": { "data": null, "error": { "code": "INTERNAL_ERROR", "message": "Internal server error." } } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" },
      "ErrorDetail": { "type": "object", "required": ["field", "message"], "properties": { "field": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": false },
      "ApiError": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } } }, "additionalProperties": false },
      "ErrorEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "type": "null" }, "error": { "$ref": "#/components/schemas/ApiError" } }, "additionalProperties": false },
      "Conversation": { "type": "object", "required": ["id", "projectId", "title", "status", "lastActivityAt", "createdAt", "updatedAt"], "properties": { "id": { "$ref": "#/components/schemas/Uuid" }, "projectId": { "$ref": "#/components/schemas/Uuid" }, "title": { "type": "string", "maxLength": 160 }, "status": { "type": "string", "enum": ["active", "archived"] }, "lastActivityAt": { "type": "string", "format": "date-time" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "Message": { "type": "object", "required": ["id", "conversationId", "role", "sequence", "content", "createdAt"], "properties": { "id": { "$ref": "#/components/schemas/Uuid" }, "conversationId": { "$ref": "#/components/schemas/Uuid" }, "role": { "type": "string", "enum": ["user", "assistant", "system", "tool"] }, "sequence": { "type": "integer", "minimum": 1 }, "content": { "type": "string", "maxLength": 20000 }, "createdAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "CreateConversationRequest": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 160, "description": "Trimmed non-whitespace title without control characters." } }, "additionalProperties": false },
      "CreateMessageRequest": { "type": "object", "required": ["content"], "properties": { "content": { "type": "string", "minLength": 1, "maxLength": 20000, "description": "Non-whitespace plain text; line breaks are preserved." } }, "additionalProperties": false },
      "ConversationList": { "type": "object", "required": ["conversations", "nextCursor"], "properties": { "conversations": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } }, "nextCursor": { "type": "string", "nullable": true } }, "additionalProperties": false },
      "ConversationHistory": { "type": "object", "required": ["conversation", "messages", "nextBeforeSequence"], "properties": { "conversation": { "$ref": "#/components/schemas/Conversation" }, "messages": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } }, "nextBeforeSequence": { "type": "integer", "minimum": 1, "nullable": true } }, "additionalProperties": false },
      "ConversationEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/Conversation" }, "error": { "type": "null" } }, "additionalProperties": false },
      "MessageEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/Message" }, "error": { "type": "null" } }, "additionalProperties": false },
      "ConversationListEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/ConversationList" }, "error": { "type": "null" } }, "additionalProperties": false },
      "ConversationHistoryEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/ConversationHistory" }, "error": { "type": "null" } }, "additionalProperties": false },
      "CreateAiRunRequest": { "type": "object", "required": ["conversationId", "request"], "properties": { "conversationId": { "$ref": "#/components/schemas/Uuid" }, "request": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "Trimmed request, capped at 8,000 UTF-8 bytes; credential-like assignments are rejected." }, "context": { "type": "object", "properties": { "relativePaths": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 2048 } }, "includeRecentMessages": { "type": "boolean", "default": false, "description": "Selects at most 20 latest redacted messages within the aggregate byte/token ceiling." } }, "additionalProperties": false } }, "additionalProperties": false },
      "EgressDecisionRequest": { "type": "object", "required": ["manifestHash", "decision"], "properties": { "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decision": { "type": "string", "enum": ["approve", "reject"] } }, "additionalProperties": false },
      "AiRunSnapshot": { "type": "object", "required": ["runId", "projectId", "conversationId", "status", "phase", "manifestHash", "decision", "safeMessage", "cleanup", "providerTransmission", "stagingItemCount"], "properties": { "runId": { "$ref": "#/components/schemas/Uuid" }, "projectId": { "$ref": "#/components/schemas/Uuid" }, "conversationId": { "$ref": "#/components/schemas/Uuid" }, "status": { "type": "string", "enum": ["pending_approval", "rejected", "staging", "ready", "queued", "running", "waiting_approval", "succeeded", "failed", "cancel_requested", "cancelled", "blocked", "review_required"] }, "phase": { "type": "string", "enum": ["manifest", "decision", "staging", "runtime", "inference", "terminal", "review"] }, "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decision": { "type": "string", "enum": ["pending", "approved", "rejected"] }, "safeMessage": { "type": "string" }, "cleanup": { "type": "string", "enum": ["not_started", "complete", "unknown"] }, "providerTransmission": { "type": "string", "enum": ["not_started", "not_started_confirmed", "unknown"] }, "stagingItemCount": { "type": "integer", "minimum": 0 }, "runtime": { "type": "object", "required": ["kind", "sandboxReady"], "properties": { "kind": { "type": "string", "enum": ["fake"] }, "sandboxReady": { "type": "boolean", "enum": [true] } }, "additionalProperties": false }, "assistant": { "type": "object", "required": ["complete", "contentLength"], "properties": { "messageId": { "$ref": "#/components/schemas/Uuid" }, "complete": { "type": "boolean" }, "contentLength": { "type": "integer", "minimum": 0, "maximum": 65536 } }, "additionalProperties": false } }, "additionalProperties": false },
      "EgressManifest": { "type": "object", "required": ["runId", "manifestHash", "status", "provider", "providerProfile", "model", "content", "redaction", "bestEffortSecretDetection", "preConsentNotice"], "properties": { "runId": { "$ref": "#/components/schemas/Uuid" }, "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "status": { "type": "string" }, "provider": { "type": "string", "example": "NVIDIA hosted NIM" }, "providerProfile": { "type": "string" }, "model": { "type": "string", "example": "nvidia/nemotron-3-super-120b-a12b" }, "content": { "type": "object", "required": ["categories", "relativePaths", "itemCount", "byteEstimate", "tokenEstimate", "messageCount"], "properties": { "categories": { "type": "array", "items": { "type": "string" } }, "relativePaths": { "type": "array", "items": { "type": "string" } }, "itemCount": { "type": "integer", "minimum": 0 }, "byteEstimate": { "type": "integer", "minimum": 0 }, "tokenEstimate": { "type": "integer", "minimum": 0 }, "messageCount": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "redaction": { "type": "object", "required": ["excludedItemCount", "omittedItemCount", "summary"], "properties": { "excludedItemCount": { "type": "integer", "minimum": 0 }, "omittedItemCount": { "type": "integer", "minimum": 0 }, "summary": { "type": "string" } }, "additionalProperties": false }, "bestEffortSecretDetection": { "type": "boolean", "enum": [true] }, "preConsentNotice": { "type": "string" }, "emptyContextNotice": { "type": "string" } }, "additionalProperties": false },
      "AiRunIntent": { "type": "object", "required": ["run", "manifest"], "properties": { "run": { "$ref": "#/components/schemas/AiRunSnapshot" }, "manifest": { "$ref": "#/components/schemas/EgressManifest" } }, "additionalProperties": false },
      "AiRunEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/AiRunSnapshot" }, "error": { "type": "null" } }, "additionalProperties": false },
      "AiRunIntentEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/AiRunIntent" }, "error": { "type": "null" } }, "additionalProperties": false },
      "EgressManifestEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/EgressManifest" }, "error": { "type": "null" } }, "additionalProperties": false },
      "EgressDecisionEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/AiRunIntent" }, "error": { "type": "null" } }, "additionalProperties": false },
      "EmptyObject": { "type": "object", "additionalProperties": false },
      "SandboxCommandDecisionRequest": { "type": "object", "required": ["proposalHash", "decision"], "properties": { "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decision": { "type": "string", "enum": ["approve", "reject"] } }, "additionalProperties": false },
      "SandboxCommandLimits": { "type": "object", "required": ["wallTimeMs", "idleTimeMs", "maxOutputBytes", "maxProcesses", "memoryBytes", "cpuTimeMs", "network"], "properties": { "wallTimeMs": { "type": "integer", "minimum": 1, "maximum": 30000 }, "idleTimeMs": { "type": "integer", "minimum": 1, "maximum": 10000 }, "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }, "maxProcesses": { "type": "integer", "minimum": 1, "maximum": 8 }, "memoryBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "cpuTimeMs": { "type": "integer", "minimum": 1, "maximum": 10000 }, "network": { "type": "string", "enum": ["denied"] } }, "additionalProperties": false },
      "SandboxCommandResult": { "type": "object", "required": ["exitCode", "termination", "durationMs", "outputBytes", "outputLineCount", "outputTruncated", "outputSha256"], "properties": { "exitCode": { "type": "integer", "nullable": true }, "termination": { "type": "string", "enum": ["completed", "failed", "timed_out", "output_truncated", "cancelled"] }, "durationMs": { "type": "integer", "minimum": 0 }, "outputBytes": { "type": "integer", "minimum": 0 }, "outputLineCount": { "type": "integer", "minimum": 0 }, "outputTruncated": { "type": "boolean" }, "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "outputPreview": { "type": "string", "maxLength": 4096, "description": "Optional server-redacted plain-text preview; never HTML or ANSI." } }, "additionalProperties": false },
      "SandboxCommand": { "type": "object", "required": ["commandId", "runId", "proposalHash", "command", "summary", "argumentCount", "argumentSummaries", "cwd", "classification", "decision", "status", "runtimeKind", "limits", "safeMessage", "createdAt", "updatedAt"], "properties": { "commandId": { "$ref": "#/components/schemas/Uuid" }, "runId": { "$ref": "#/components/schemas/Uuid" }, "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "command": { "type": "string" }, "summary": { "type": "string", "maxLength": 160, "description": "Server-bounded plain-text command summary; it never contains raw paths or credentials." }, "argumentCount": { "type": "integer", "minimum": 0 }, "argumentSummaries": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } }, "cwd": { "type": "string", "description": "Safe display-relative working-directory label." }, "classification": { "type": "string", "enum": ["safe", "sensitive", "blocked"] }, "decision": { "type": "string", "enum": ["pending", "approved", "rejected", "not_applicable"] }, "status": { "type": "string", "enum": ["awaiting_approval", "running", "completed", "failed", "timed_out", "output_truncated", "rejected", "blocked", "cancel_requested", "cancelled", "review_required"] }, "runtimeKind": { "type": "string", "enum": ["fake"] }, "limits": { "$ref": "#/components/schemas/SandboxCommandLimits" }, "result": { "$ref": "#/components/schemas/SandboxCommandResult" }, "safeMessage": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "SandboxCommandList": { "type": "object", "required": ["commands"], "properties": { "commands": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/SandboxCommand" } } }, "additionalProperties": false },
      "SandboxCommandEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "type": "object", "required": ["command"], "properties": { "command": { "$ref": "#/components/schemas/SandboxCommand" } }, "additionalProperties": false }, "error": { "type": "null" } }, "additionalProperties": false },
      "SandboxCommandListEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/SandboxCommandList" }, "error": { "type": "null" } }, "additionalProperties": false }
      ,"WorkspaceEntry": { "type": "object", "required": ["path", "name", "type"], "properties": { "path": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string", "enum": ["file", "directory"] }, "sizeBytes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
      "WorkspaceList": { "type": "object", "required": ["directory", "entries", "truncated"], "properties": { "directory": { "type": "string" }, "entries": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceEntry" } }, "truncated": { "type": "boolean" } }, "additionalProperties": false },
      "WorkspaceTreeNode": { "allOf": [{ "$ref": "#/components/schemas/WorkspaceEntry" }, { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceTreeNode" } } }, "additionalProperties": false }] },
      "WorkspaceTree": { "type": "object", "required": ["directory", "depth", "entries", "truncated"], "properties": { "directory": { "type": "string" }, "depth": { "type": "integer", "minimum": 0 }, "entries": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceTreeNode" } }, "truncated": { "type": "boolean" } }, "additionalProperties": false },
      "WorkspaceRead": { "type": "object", "required": ["path", "content", "encoding", "sizeBytes", "lineCount", "truncated"], "properties": { "path": { "type": "string" }, "content": { "type": "string" }, "encoding": { "type": "string", "enum": ["utf-8"] }, "sizeBytes": { "type": "integer", "minimum": 0 }, "lineCount": { "type": "integer", "minimum": 0 }, "truncated": { "type": "boolean" } }, "additionalProperties": false },
      "WorkspaceSearchMatch": { "type": "object", "required": ["path", "line", "column", "text"], "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }, "text": { "type": "string" } }, "additionalProperties": false },
      "WorkspaceSearch": { "type": "object", "required": ["directory", "query", "matches", "filesScanned", "truncated"], "properties": { "directory": { "type": "string" }, "query": { "type": "string" }, "matches": { "type": "array", "items": { "$ref": "#/components/schemas/WorkspaceSearchMatch" } }, "filesScanned": { "type": "integer", "minimum": 0 }, "truncated": { "type": "boolean" } }, "additionalProperties": false },
      "WorkspaceListEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/WorkspaceList" }, "error": { "type": "null" } }, "additionalProperties": false },
      "WorkspaceTreeEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/WorkspaceTree" }, "error": { "type": "null" } }, "additionalProperties": false },
      "WorkspaceReadEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/WorkspaceRead" }, "error": { "type": "null" } }, "additionalProperties": false },
      "WorkspaceSearchEnvelope": { "type": "object", "required": ["data", "error"], "properties": { "data": { "$ref": "#/components/schemas/WorkspaceSearch" }, "error": { "type": "null" } }, "additionalProperties": false }
    }
  }
}
